# Guest portal administrator account
ADMIN_USER=
ADMIN_PASSWORD=

# Third-party / police dashboard account
STAFF_USER=
STAFF_PASSWORD=

# Captive portal access code and signing secret
PORTAL_ACCESS_CODE=
PORTAL_SECRET=

# Self-hosted UniFi Network Server
UNIFI_URL=https://YOUR_UNIFI_CONTROLLER:8443
UNIFI_SITE=default
UNIFI_USERNAME=
UNIFI_PASSWORD=
UNIFI_VERIFY_TLS=false

# Guest authorization lifetime
AUTH_MINUTES=480

# Set true only after HTTPS is enabled for the staff dashboard
STAFF_COOKIE_SECURE=false
