# Guest portal administrator account
ADMIN_USER=
ADMIN_PASSWORD=

# Third-party / police dashboard account
STAFF_USER=
STAFF_PASSWORD=

# Captive portal signing secret
PORTAL_SECRET=

# Optional. Defaults to /opt/unifi-portal/portal.db
# PORTAL_DB_PATH=/opt/unifi-portal/portal.db

# Self-hosted UniFi Network Server
UNIFI_URL=https://YOUR_UNIFI_CONTROLLER:8443
UNIFI_SITE=default
UNIFI_USERNAME=
UNIFI_PASSWORD=
UNIFI_VERIFY_TLS=false

# Guests must register again after local midnight
AUTH_RESET_TIMEZONE=Asia/Shanghai

# Automatic disconnect checks only recently expired registrations.
# The systemd timer runs at 00:01 in Asia/Shanghai.
EXPIRY_DISCONNECT_LOOKBACK_HOURS=24

# Brute-force protection. Values are seconds except *_MAX_FAILURES.
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_WINDOW_SECONDS=600
ADMIN_LOGIN_BLOCK_SECONDS=900
STAFF_LOGIN_MAX_FAILURES=5
STAFF_LOGIN_WINDOW_SECONDS=600
STAFF_LOGIN_BLOCK_SECONDS=900

# Staff dashboard records returned per page (10-100)
DASHBOARD_PAGE_SIZE=50

# Set true only after HTTPS is enabled for the staff dashboard
STAFF_COOKIE_SECURE=false

# Set true only after HTTPS is enabled for the admin dashboard
ADMIN_COOKIE_SECURE=false
